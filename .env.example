# 阿里云百炼（必填）：https://bailian.console.aliyun.com 获取 API Key
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_TEXT_MODEL=qwen-plus
BAILIAN_VL_MODEL=qwen-vl-max

# 飞猪 flyai（必填，否则价格脱敏）
FLYAI_API_KEY=
# live = 调用 flyai CLI；fixture = 使用 fixtures/ 下的样例数据（离线演示/测试）
FLYAI_MODE=live
FLYAI_BIN=flyai

# 高德 Web 服务 Key（可选）：用于把 POI 地址转成坐标、计算步行/车程。不填则按地址文本粗分层
AMAP_KEY=
