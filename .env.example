# 阿里云百炼（必填）：https://bailian.console.aliyun.com 获取 API Key
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_TEXT_MODEL=qwen-plus
BAILIAN_VL_MODEL=qwen3-vl-plus

# 飞猪 flyai（必填，否则价格脱敏）
FLYAI_API_KEY=
# live = 调用 flyai CLI；fixture = 使用 fixtures/ 下的样例数据（离线演示/测试）
FLYAI_MODE=live
FLYAI_BIN=flyai

# 高德 Key（可选，需“Web服务”类型）：生成“酒店内外”真实地图（静态地图 API），并为缺坐标的 POI 补坐标。
# 不填则显示方位示意图。申请：lbs.amap.com → 控制台 → 应用管理 → 创建应用 → 添加 Key，服务平台选“Web服务”
AMAP_KEY=
