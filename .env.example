# 阿里云百炼（必填）：https://bailian.console.aliyun.com 获取 API Key
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_TEXT_MODEL=qwen-plus
BAILIAN_VL_MODEL=qwen3-vl-plus

# 飞猪 flyai（必填，否则价格脱敏）：查火车与航班
FLYAI_API_KEY=
FLYAI_BIN=flyai

# 高德 Key（必填，需“Web服务”类型）：把每个地点定位到省 / 市，判断是否在过境免签允许停留区域内。
# 申请：lbs.amap.com → 控制台 → 应用管理 → 创建应用 → 添加 Key，服务平台选“Web服务”
AMAP_KEY=
